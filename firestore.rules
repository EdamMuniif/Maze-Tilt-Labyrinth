rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players_s2/{id} {
      allow read: if true;
      allow create: if valid(request.resource.data);
      // A player's total can only go up, and nobody can delete a row.
      allow update: if valid(request.resource.data)
                    && request.resource.data.total >= resource.data.total;
      allow delete: if false;
      function valid(d) {
        return d.keys().hasOnly(['name', 'total', 'scores', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
          && d.total is int && d.total >= 0 && d.total <= 150000
          && d.scores is map && d.scores.size() <= 20;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
